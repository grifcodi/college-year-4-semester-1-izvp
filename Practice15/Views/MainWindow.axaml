<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Practice15.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="600"
        x:Class="Practice15.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="My Task Manager">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <UniformGrid Rows="1" Columns="2">

        <Grid RowDefinitions="Auto, *, Auto">

            <Viewbox Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Top">
                <Border
                    Margin="5, 10, 5, 5"
                    CornerRadius="10"
                    HorizontalAlignment="Center"
                    Background="LightBlue">
                    <TextBlock
                        Margin="5"
                        FontSize="24"
                        Text="Task Manager">
                    </TextBlock>
                </Border>
            </Viewbox>
                
            <Viewbox Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border
                    Margin="10"
                    Padding="10"
                    CornerRadius="10"
                    Background="Gray">

                    <Grid
                        ColumnDefinitions="Auto, Auto"
                        RowDefinitions="Auto, Auto">

                        <Button Grid.Row="0" Grid.Column="0" 
                                Margin="5 0" 
                                HorizontalAlignment="Center"
                                HorizontalContentAlignment="Stretch"
                                Command="{Binding AddTaskCommand}"
                                Content="Add Task"/>

                        <TextBox Grid.Row="0" Grid.Column="1" 
                                 Margin="5"
                                 Width="100"
                                 PlaceholderText="Task Practice"
                                 Text="{Binding TaskText}"/>

                        <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                Margin="5"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Command="{Binding DeleteTaskCommand}"
                                Content="Delete Task"/>
                    </Grid>                
                </Border>
            </Viewbox>

            <Viewbox Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                <Border Margin="2"
                        Padding="2"
                        CornerRadius="5"
                        Background="Cyan">
                
                        <TextBlock
                            Margin="2"
                            FontSize="16"
                            FontWeight="Bold"
                            HorizontalAlignment="Center"
                            Text="{Binding CompletedTasks, StringFormat='Completed tasks: {0}'}"/>

                </Border>

            </Viewbox>
            
        </Grid>

        <ListBox ItemsSource="{Binding Tasks}"
                 SelectedItem="{Binding SelectedTask}"
                 Margin="10"
                 Background="Transparent">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="15">
                        <Viewbox Width="42" Height="42">
                            <CheckBox IsChecked="{Binding Completed}" />
                        </Viewbox>

                        <TextBlock Text="{Binding Name}" 
                                   VerticalAlignment="Center" 
                                   FontSize="22"
                                   Classes.isCompleted="{Binding Completed}">
                            <TextBlock.Styles>
                                <Style Selector="TextBlock.isCompleted">
                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                    <Setter Property="Foreground" Value="Gray" />
                                </Style>
                            </TextBlock.Styles>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        

    </UniformGrid>

</Window>
